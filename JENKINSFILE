pipeline {
    agent any

    stages {
        stage('Get Code') {
            steps {
                // Obtener código repo
                git 'https://github.com/bryvid09/helloworld'
            }
        }

        stage('Analysis') {
            stages {
                stage('Static') {
                    steps {
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            sh '''
                                flake8 --exit-zero --format=pylint app >flake8.out
                            '''

                                recordIssues tools: [flake8(name: 'Flake8', pattern: 'flake8.out')],
                                    qualityGates: [
                                        [criticality: 'UNSTABLE', threshold: 8, type: 'TOTAL', unestable: true],
                                        [criticality: 'FAILURE', threshold: 10, type: 'TOTAL', unestable: false]
                                    ],
                                    unhealthy: 10
                        }
                    }
                }

                stage('Security') {
                    steps {
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            sh '''
                                    bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}] {msg}"
                                '''

                            recordIssues tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')],
                                    qualityGates: [
                                        [criticality: 'UNSTABLE', threshold: 2, type: 'TOTAL', unestable: true],
                                        [criticality: 'FAILURE', threshold: 4, type: 'TOTAL', unestable: false]
                                    ],
                                    unhealthy: 4
                        }
                    }
                }
            }
        }

        stage('Test') {
            stages {
                stage('Unit') {
                    steps {
                        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                            sh '''
                                export PYTHONPATH=$WORKSPACE
                                coverage run --branch --source=app --omit="app/__init__.py,app/api.py" -m pytest --junitxml=result-unit.xml test/unit
                            '''
                        }

                        junit 'result-unit.xml'
                    }
                }

                stage('Rest') {
                    steps {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            sh '''
                                export FLASK_APP=app/api.py
                                export FLASK_ENV=development
                                flask run &
                                java -jar /opt/wiremock/wiremock.jar --port 9090 --root-dir test/wiremock &
                                sleep 2
                                export PYTHONPATH=$WORKSPACE
                                pytest --junitxml=result-rest.xml test/rest
                            '''
                        }

                        junit 'result-rest.xml'
                    }
                }

                stage('Coverage') {
                    steps {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            sh 'coverage xml'

                            recordCoverage tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']],
                                qualityGates: [
                                    [threshold: 85.0, metric: 'LINE', baseline: 'PROJECT', criticality: 'FAILURE'],
                                    [threshold: 95.0, metric: 'LINE', baseline: 'PROJECT', criticality: 'UNSTABLE'],
                                    [threshold: 80.0, metric: 'BRANCH', baseline: 'PROJECT', criticality: 'FAILURE'],
                                    [threshold: 90.0, metric: 'BRANCH', baseline: 'PROJECT', criticality: 'UNSTABLE']
                                ]
                        }
                    }
                }
            }
        }

        stage('Perfomance') {
            steps {
                sh '/opt/jmeter/bin/jmeter -n -t test/jmeter/flask.jmx -f -l flask.jtl'
                perfReport sourceDataFiles: 'flask.jtl'
            }
        }
    }
}
