pipeline {
    agent any
    
    stages{
        stage('Get Code') {
            steps{
                // Obtener código repo
                git 'https://github.com/bryvid09/helloworld'
            }
        }
        
        stage('Build') {
            steps {
                echo 'EyyYY, esto es Python. No hay que compilar nada!!!'
                echo WORKSPACE
                sh 'ls'
            }
        }
        
        stage('Test') {
            parallel {
                stage('Unit') {
                    steps {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            sh '''
                                export PYTHONPATH=$WORKSPACE
                                pytest --junitxml=result-unit.xml test/unit   
                            '''
                        }
                    }
                }
        
                stage('Rest') {
                    steps {
                        sh '''
                            export FLASK_APP=app/api.py
                            export FLASK_ENV=development
                            flask run &
                            java -jar /opt/wiremock/wiremock.jar --port 9090 --root-dir test/wiremock &
                            sleep 2
                            export PYTHONPATH=$WORKSPACE
                            pytest --junitxml=result-rest.xml test/rest
                        '''
                    }   
                } 
            }
        }
        
        stage('Results') {
            steps {
                junit 'result*.xml'
            }
        }
    }
}
